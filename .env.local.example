# Copy to .env.local and fill in. Never commit .env.local.

# Free tier tonight; switch to the hackathon credits key at the event.
GEMINI_API_KEY=
GEMINI_TIER=free

# Model IDs: confirm the exact strings at 10:30 (Dev 1 updates these).
MODEL_SCOUT=gemini-4-hydrogen
MODEL_JUDGE=gemini-4-carbon
MODEL_DECIDE=gemini-decision-1
MODEL_BASELINE=gemini-4-neon
AGENT_ID=antigravity-preview-05-2026
# Leave empty if agent_config rejects it.
AGENT_MODEL=gemini-4-hydrogen

# Agent mode: standin (ordinary function-calling model, the default when unset) or managed (Gemini Managed Agent).
# Set AGENT_MODE=managed on the demo laptop only; everywhere else leave it as standin.
AGENT_MODE=standin
# standin = if the managed agent fails on its first turn, rerun that claim with the stand-in
# (recorded as mode "standin-fallback"). Empty = no fallback.
AGENT_FALLBACK=
# Longest a managed-agent turn may stay in_progress before it counts as model_unavailable.
AGENT_TURN_TIMEOUT_MS=30000
# Managed-agent USD prices per million tokens, for the cost log. Empty = logged as $0 (with a warning).
MANAGED_PRICE_IN=
MANAGED_PRICE_OUT=

# Stand-in agent (lib/agent/standin.ts, free tier). Empty = use MODEL_SCOUT.
STANDIN_MODEL=
# Stand-in USD prices per million tokens, for the cost log. Empty = logged as $0 (with a warning).
STANDIN_PRICE_IN=
STANDIN_PRICE_OUT=

# Backoff before each retry of a 429/503 model error, comma-separated ms (one retry per entry).
# For the live demo use 500,1000 (about 1.5 s worst case per turn).
MODEL_RETRY_DELAYS_MS=1000,2000,4000

# Budget and limits
BUDGET_HARD_STOP_USD=8
AGENT_MAX_TOTAL_TOKENS=60000
# Keep low on the free tier to avoid rate-limit errors; raise with credits.
MAX_CONCURRENT_CALLS=2

DATA_DIR=./data
